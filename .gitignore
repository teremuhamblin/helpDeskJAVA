# ==============================================================================
#  helpDeskJAVA — .gitignore (v1.2 Stable)
# ==============================================================================

# --- 1. Compilation Java & Binaires (générés par javac -d) ---
bin/
bin-test/
out/
build/
target/
*.class
*.ctxt

# --- 2. Logs JVM & Fichiers d'erreur ---
*.log
hs_err_pid*
replay_pid*

# --- 3. Fichiers générés à l'exécution & Sécurité des données ---
# Évite de publier des données sensibles (SN, IP, MAC, IMEI, utilisateurs) sur GitHub
*.tmp
*.bak
parc_helpdesk.txt
parc_rapport.csv
data/

# --- 4. Dépendances / Archives ---
# Si vous ajoutez un .jar dans lib/ sans Maven/Gradle, il reste suivi grâce à !lib/*.jar
*.jar
*.war
*.ear
*.zip
*.tar.gz
!lib/*.jar

# --- 5. Environnements de développement (IDE) ---
# Visual Studio Code
.vscode/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Eclipse
.classpath
.project
.settings/
.metadata/

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/

# --- 6. Futur support Gradle / Maven ---
.gradle/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup

# --- 7. Systèmes d'exploitation (OS) ---
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# --- 8. Secrets & Variables locales ---
.env
.env.local
*.key
*.pem
